# Copy to /opt/vgreens-ai/.env  (root-only: chmod 600, owned by root).
# NEVER commit the real .env — only this example lives in git.

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=vgreens
# LONG ALPHANUMERIC ONLY — no special chars (they broke cifs parsing during infra
# setup; keep the same discipline everywhere for consistency).
RABBITMQ_PASSWORD=CHANGEME_long_alphanumeric_password
# Bind address for the broker ports. 0.0.0.0 = all interfaces (fine on this private
# LAN). Set to 127.0.0.1 to keep the broker host-local while testing.
RABBITMQ_BIND=0.0.0.0

# --- Monitoring (Phase 2.5) ------------------------------------------------
# Prometheus (9090) + Grafana (3000) bind. Default localhost — reach via SSH
# tunnel. Set to a LAN IP to expose on the LAN.
MON_BIND=127.0.0.1
GRAFANA_PASSWORD=CHANGEME_grafana_admin_password

# --- Job API (used from step 1.3) ------------------------------------------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
JOBS_DB_PATH=/opt/vgreens-ai/jobs.db
NAS_MOUNTPOINT=/mnt/vgreens_storage
NAS_JOBS_ROOT=/mnt/vgreens_storage/ai/jobs
# name:token pairs. token name becomes requested_by on jobs.
TOKENS=achref:CHANGEME_token_alphanumeric

# --- Worker (used from step 1.5) -------------------------------------------
API_URL=http://127.0.0.1:8000
API_TOKEN=CHANGEME_token_alphanumeric
