# /etc/systemd/system/vgreens-ai-api.service   (deployed in step 1.3)
[Unit]
Description=vGreens Job API (FastAPI)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=vgreens
WorkingDirectory=/opt/vgreens-ai/repo/api
EnvironmentFile=/opt/vgreens-ai/.env
ExecStart=/opt/vgreens-ai/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
