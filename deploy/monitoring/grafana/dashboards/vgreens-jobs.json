        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "vgreens_queue_depth{type=\"processing\"}",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
